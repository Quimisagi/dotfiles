{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/Pictures/yotsuba2.png",
        "type": "auto",
        "width": 32,
        "height": 15,
        "padding": {
            "top": 0,
            "right": 8,
            "left": 4
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "magenta"
        }
    },
    "modules": [
        "break",
        "break",
        {
            "type": "custom",
            "format": "╭─────────── 󰀚 \u001b[1mQuimisagi's PC\u001b[0m ──────────────╮",
            "outputColor": "38;2;180;190;254" // Soft Blue
        },
        {
            "type": "os",
            "key": "│ 󰣇 OS     ",
            "keyColor": "38;2;243;139;168" // Rose
        },
        {
            "type": "kernel",
            "key": "│ 󰌽 KER    ",
            "keyColor": "38;2;250;179;135" // Peach
        },
        {
            "type": "wm",
            "key": "│  WM     ",
            "keyColor": "38;2;249;226;175" // Yellow
        },
        {
            "type": "shell",
            "key": "│  SH     ",
            "keyColor": "38;2;166;227;161" // Green
        },
        {
            "type": "packages",
            "key": "│ 󰏖 PKG    ",
            "keyColor": "38;2;148;226;213" // Teal
        },
        {
            "type": "cpu",
            "key": "│  CPU    ",
            "keyColor": "38;2;137;180;250" // Blue
        },
        {
            "type": "gpu",
            "key": "│ 󰢮 GPU    ",
            "keyColor": "38;2;203;166;247" // Mauve
        },
        {
            "type": "memory",
            "key": "│  MEM    ",
            "keyColor": "38;2;245;194;231" // Flamingo
        },
        {
            "type": "custom",
            "format": "╰──────────────────────────────────────────╯",
            "outputColor": "38;2;180;190;254"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
